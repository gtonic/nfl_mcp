# Keep the image clean & reproducible — don't bake in local state.

# Git & CI
.git
.github
.gitignore

# Virtual envs
.venv
.venv*
venv

# Python caches / build artifacts
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info
build
dist
htmlcov
.coverage
.coverage.*

# Secrets (API keys live in a gitignored .env; pass them at run time instead)
.env
.env.*
!.env.example

# Local databases and data (must not ship in the image), incl. WAL sidecars
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Agent / tool state and local tool environments
.claude
.claude/
.tox
.nox
.uv-cache
uv.lock
*.log

# Tests & docs (not needed at runtime)
tests
docs
examples
*.md
!README.md

# Editor / OS
.vscode
.idea
.DS_Store
